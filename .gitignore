assets/profile_pure_base.png
assets/profile_true.png
assets/test_48_bicubic.png
assets/test_48_bicubic_8x.png
assets/test_48_nn.png
assets/test_48_nn_8x.png
assets/test_ref_quantized_8x.png

# Node.js (for legacy archive prototypes)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE, Editor & Tooling files
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
.gemini/

# Operating System temporary files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Scratch files & backups
*.tmp
*.temp
*.swp
*.bak
*~
