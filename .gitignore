# =========================================================================
# .gitignore for Cute Owl Desktop Pet (Low-Res Pixel Art)
# =========================================================================

# Build artifacts & temporary binaries
bin/
obj/
*.pdb
*.ilk
*.obj
*.log
*.tlog

# Executable binaries: ignore all temporary / test executables
*.exe
# Allow pre-compiled standalone pet executable for zero-setup execution
!DesktopPet.exe

# Legacy prototypes and heavy experimental archives
archive/

# Intermediate / experimental sprite variations and drafts
assets/sprites/walk_front/
assets/sprites/walk_profile/

# Intermediate comparison and draft images in assets/
assets/comparison_reference_vs_matrix.png
assets/extracted_grid.txt
assets/eye_crop.png
